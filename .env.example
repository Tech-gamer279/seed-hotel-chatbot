# Copy this file to .env and fill in your values
# Never commit .env to version control

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/seed_hotel

# OpenAI (via Replit AI Integrations or your own key)
AI_INTEGRATIONS_OPENAI_BASE_URL=https://...
AI_INTEGRATIONS_OPENAI_API_KEY=your_openai_api_key_here

# Auth session secret (generate a strong random string)
SESSION_SECRET=your_random_session_secret_here

# Replit environment (auto-set on Replit)
REPL_ID=
REPLIT_DOMAINS=
REPLIT_DEV_DOMAIN=
